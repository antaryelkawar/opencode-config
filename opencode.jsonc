{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/agentic",
  "small_model": "litellm/speed",
  "shell": "powershell",
  "instructions": [
    ".opencode/docs/git-safety.md",
    ".opencode/prompts/subagent-routing.md",
    ".opencode/standards/README.md"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.1.103:4000/v1",
        "apiKey": "sk-litellm-master-key",
        "timeout": 600000,
        "headerTimeout": 600000,
        "retries": 12
      },
      "models": {
        "reasoning": {
          "name": "Reasoning"
        },
        "design": {
          "name": "Design"
        },
        "agentic": {
          "name": "Agentic"
        },
        "agentic-free": {
          "name": "Agentic Free"
        },
        "generalist": {
          "name": "Generalist"
        },
        "generalist-mimo": {
          "name": "Generalist MiMo"
        },
        "speed": {
          "name": "Speed"
        },
        "speed-cheapest": {
          "name": "Speed Cheapest"
        },
        "local-fast": {
          "name": "Local Fast",
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "variants": {
            "none": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            },
            "low": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "low"
              }
            },
            "medium": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "medium"
              }
            },
            "high": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "xhigh"
              }
            }
          }
        },
        "local-quality": {
          "name": "Local Quality",
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "variants": {
            "none": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            },
            "low": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "low"
              }
            },
            "medium": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "medium"
              }
            },
            "high": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "xhigh"
              }
            }
          }
        }
      }
    },
    "local-fast": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.1.39:8090/v1",
        "apiKey": "not-needed",
        "timeout": 600000,
        "headerTimeout": 600000,
        "retries": 12
      },
      "models": {
        "default": {
          "name": "Local Fast Direct",
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "variants": {
            "none": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            },
            "low": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "low"
              }
            },
            "medium": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "medium"
              }
            },
            "high": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "xhigh"
              }
            }
          }
        }
      }
    },
    "local-quality": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.1.103:11234/v1",
        "apiKey": "not-needed",
        "timeout": 600000,
        "headerTimeout": 600000,
        "retries": 12
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Local Quality Direct",
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "variants": {
            "none": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            },
            "low": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "low"
              }
            },
            "medium": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "medium"
              }
            },
            "high": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "xhigh"
              }
            }
          }
        }
      }
    }
  },
  // Local plugins are auto-discovered from .opencode/plugins/<id>/index.ts in V2.
  // opencode-plugin-openspec was V1-only (no V2 release); removed with the V2 plugin API migration.
  "mcp": {
    "idea": {
      "type": "remote",
      "url": "http://127.0.0.1:65237/sse",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--caps",
        "vision,devtools"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "tools": {
    "chrome-devtools*": false,
    "playwright*": false
  },
  "agent": {
    "build": {
      "description": "Main development agent with full tool access",
      "model": "litellm/agentic"
    },
    "plan": {
      "description": "Planning agent - analyzes and suggests without making changes",
      "model": "litellm/generalist",
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    "general": {
      "description": "General-purpose agent for multi-step tasks",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/generalist",
      "prompt": "{file:./.opencode/prompts/general-instructions.md}",
      "permission": {
        "question": "allow",
        "skill": {
          "*": "deny",
          "frontend-impl": "allow",
          "commit-helper": "allow",
          "tdd": "allow"
        }
      }
    },
    "explore": {
      "description": "Fast exploration agent - read-only code analysis",
      "mode": "subagent",
      "steps": 30,
      "model": "litellm/speed-cheapest",
      "prompt": "{file:./.opencode/prompts/explore-instructions.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": true
      },
      "permission": {
        "question": "allow",
        "skill": {
          "*": "deny",
          "zoom-out": "allow"
        }
      }
    },
    "explore-cheap": {
      "description": "Cheap exploration agent - local-fast read-only code analysis, spawned by orchestrators",
      "mode": "subagent",
      "hidden": true,
      "steps": 75,
      "model": "litellm/local-fast",
      "variant": "none",
      "prompt": "{file:./.opencode/prompts/explore-instructions.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": true
      },
      "permission": {
        "question": "allow",
        "skill": {
          "*": "deny",
          "zoom-out": "allow"
        }
      }
    },
    "code-reviewer": {
      "description": "Code review agent - analyzes code quality and suggests improvements",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/agentic",
      "prompt": "{file:./.opencode/prompts/code-reviewer-instructions.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": false,
        "write": true
      },
      "permission": {
        "edit": "deny",
        "write": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "code-review": "allow",
          "review": "allow"
        }
      }
    },
    "ui-impl-worker": {
      "description": "Web/mobile UI implementation worker - React web + Expo/React Native, drives real browsers to build and verify UI",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/local-quality",
      "variant": "low",
      "temperature": 0.2,
      "prompt": "{file:./.opencode/prompts/ui-impl-worker-instructions.md}",
      "tools": {
        "chrome-devtools*": true,
        "playwright*": true
      },
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "deny",
          "ui-reviewer": "allow",
          "ui-impl-worker-cheap": "allow",
          "explore-cheap": "allow"
        },
        "skill": {
          "*": "deny",
          "frontend-impl": "allow",
          "mobile-impl": "allow",
          "tdd": "allow",
          "task-breakdown": "allow",
          "code-review": "allow"
        }
      }
    },
    "ui-impl-worker-cheap": {
      "description": "Cheap UI implementation worker - executes single atomic UI chunks under supervision",
      "mode": "subagent",
      "hidden": true,
      "steps": 150,
      "model": "litellm/local-fast",
      "variant": "none",
      "temperature": 0.2,
      "prompt": "{file:./.opencode/prompts/ui-impl-worker-cheap-instructions.md}",
      "tools": {
        "chrome-devtools*": true,
        "playwright*": true
      },
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "webfetch": "allow",
        "skill": {
          "*": "deny",
          "frontend-impl": "allow",
          "mobile-impl": "allow",
          "tdd": "allow"
        }
      }
    },
    "ui-reviewer": {
      "description": "UI/UX reviewer - audits visual design, accessibility, and responsive behavior of web/mobile UI",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/local-quality",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/ui-reviewer-instructions.md}",
      "tools": {
        "chrome-devtools*": true,
        "playwright*": true
      },
      "permission": {
        "edit": "deny",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "code-review": "allow"
        }
      }
    },
    "docs-writer": {
      "description": "Documentation writer agent - generates and maintains docs",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/generalist",
      "prompt": "{file:./.opencode/prompts/docs-writer-instructions.md}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true
      },
      "permission": {
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "docs-writer": "allow"
        }
      }
    },
    "architect": {
      "description": "System architect - designs boundaries, interfaces, and codebase structure",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/design",
      "prompt": "{file:./.opencode/prompts/architect-instructions.md}",
      "permission": {
        "edit": "ask",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "websearcher": "allow"
        },
        "skill": {
          "*": "deny",
          "improve-codebase-architecture": "allow",
          "planner": "allow",
          "spec-writer": "allow",
          "openspec-new-change": "allow",
          "openspec-propose": "allow",
          "openspec-ff-change": "allow",
          "openspec-continue-change": "allow"
        }
      }
    },
    "architect-cheap": {
      "description": "Local-model architect fallback - same prompt as architect, used when architect is rate-limited",
      "mode": "subagent",
      "hidden": true,
      "steps": 75,
      "model": "litellm/local-quality",
      "variant": "medium",
      "prompt": "{file:./.opencode/prompts/architect-instructions.md}",
      "permission": {
        "edit": "ask",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "websearcher": "allow"
        },
        "skill": {
          "*": "deny",
          "improve-codebase-architecture": "allow",
          "planner": "allow",
          "spec-writer": "allow",
          "openspec-new-change": "allow",
          "openspec-propose": "allow",
          "openspec-ff-change": "allow",
          "openspec-continue-change": "allow"
        }
      }
    },
    "debugger": {
      "description": "Root cause analyst - isolates and fixes bugs",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/agentic",
      "prompt": "{file:./.opencode/prompts/debugger-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "diagnose": "allow",
          "tdd": "allow"
        }
      }
    },
    "websearcher": {
      "description": "Web researcher - external research via web search/fetch, hardened against prompt injection",
      "mode": "subagent",
      "steps": 30,
      "model": "litellm/speed",
      "prompt": "{file:./.opencode/prompts/websearcher-instructions.md}",
      "permission": {
        "edit": "deny",
        "write": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "question": "allow",
        "skill": {
          "*": "deny"
        }
      }
    },
    "impl-worker": {
      "description": "Implementation orchestrator - delegates to cheap workers, audits results, only implements one-liners directly",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/local-quality",
      "variant": "low",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/impl-worker-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "websearch": "deny",
        "webfetch": "deny",
        "question": "allow",
        "task": {
          "*": "deny",
          "impl-worker-cheap": "allow",
          "explore-cheap": "allow",
          "review-cheap": "allow",
          "ui-impl-worker": "allow",
          "general": "allow"
        },
        "skill": {
          "*": "deny",
          "tdd": "allow",
          "task-breakdown": "allow",
          "backend-impl": "allow",
          "openspec-apply-change": "allow"
        }
      }
    },
    "impl-worker-cheap": {
      "description": "Cheap implementation worker - executes single atomic tasks under supervision",
      "mode": "subagent",
      "hidden": true,
      "steps": 75,
      "model": "litellm/local-fast",
      "variant": "none",
      "temperature": 0.3,
      "prompt": "{file:./.opencode/prompts/impl-worker-cheap-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "skill": {
          "*": "deny",
          "tdd": "allow",
          "backend-impl": "allow"
        }
      }
    },
    "designer": {
      "description": "Detail designer - turns specs into design decisions and an atomic task list",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/design",
      "temperature": 0.2,
      "prompt": "{file:./.opencode/prompts/designer-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "spec-writer": "allow",
          "planner": "allow",
          "openspec-new-change": "allow",
          "openspec-continue-change": "allow",
          "openspec-ff-change": "allow"
        }
      }
    },
    "reviewer": {
      "description": "Independent review gate - reviews spec/subspec/code against standards, reports findings by severity",
      "mode": "subagent",
      "steps": 60,
      "model": "litellm/agentic",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/reviewer-instructions.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": false,
        "write": true,
        "bash": true
      },
      "permission": {
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow",
        "bash": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "code-review": "allow",
          "review": "allow",
          "openspec-verify-change": "allow"
        }
      }
    },
    "review-cheap": {
      "description": "Cheap review agent - local-fast code review, spawned by impl-worker",
      "mode": "subagent",
      "hidden": true,
      "steps": 75,
      "model": "litellm/local-fast",
      "variant": "none",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/reviewer-instructions.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": false,
        "write": true,
        "bash": true
      },
      "permission": {
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow",
        "bash": "allow",
        "question": "allow",
        "task": {
          "*": "deny"
        },
        "skill": {
          "*": "deny",
          "code-review": "allow",
          "review": "allow"
        }
      }
    },
    "autopilot": {
      "description": "Orchestrator agent - drives the OpenSpec lifecycle state machine, delegates every phase, never implements",
      "model": "litellm/local-fast",
      "variant": "medium",
      "color": "#00BFFF",
      "prompt": "{file:./.opencode/prompts/autopilot-instructions.md}",
      "permission": {
        "edit": "allow",
        "task": {
          "*": "deny",
          "architect": "allow",
          "architect-cheap": "allow",
          "designer": "allow",
          "reviewer": "allow",
          "review-cheap": "allow",
          "impl-worker": "allow",
          "ui-impl-worker": "allow",
          "ui-reviewer": "allow",
          "explore": "allow",
          "explore-cheap": "allow",
          "websearcher": "allow",
          "general": "allow",
          "code-reviewer": "allow",
          "debugger": "allow",
          "docs-writer": "allow"
        }
      }
    }
  },
  "default_agent": "plan",
  "subagent_depth": 3,
  "lsp": true,
  "permission": {
    "edit": "allow",
    "question": "allow",
    "external_directory": "allow",
    "write": {
      ".tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "rtk git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rtk git push --force*": "deny",
      "rtk git push -f*": "deny",
      "git reset --hard*": "deny",
      "rtk git reset --hard*": "deny",
      "git clean *": "deny",
      "rtk git clean *": "deny",
      "git clean -n*": "allow",
      "rtk git clean -n*": "allow",
      "git checkout .": "deny",
      "git checkout --*": "deny",
      "git checkout -f*": "deny",
      "git restore .": "deny",
      "git restore --*": "deny",
      "rtk git checkout .": "deny",
      "rtk git checkout --*": "deny",
      "rtk git checkout -f*": "deny",
      "rtk git restore .": "deny",
      "rtk git restore --*": "deny",
      "git branch -D*": "deny",
      "rtk git branch -D*": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "rtk git stash drop*": "deny",
      "rtk git stash clear*": "deny"
    }
  }
}