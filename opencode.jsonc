{
  "$schema": "https://opencode.ai/config.json",
  // litellm provider config
  "model": "litellm/agentic",
  "small_model": "litellm/speed",
  "shell": "powershell",
  "instructions": ["docs/agents/git-safety.md"],
  "provider": {
    "litellm": {
      "options": {
        "baseURL": "http://192.168.1.103:8787/v1",
        "apiKey": "sk-litellm-master-key"
      },
      "models": {
        "reasoning":      { "name": "Reasoning" },
        "design":         { "name": "Design" },
        "agentic":        { "name": "Agentic" },
        "agentic-free":   { "name": "Agentic Free" },
        "generalist":     { "name": "Generalist" },
        "speed":          { "name": "Speed" },
        "speed-cheapest": { "name": "Speed Cheapest" },
        "local":          { "name": "Local" }
      }
    },
    "local-direct": {
      "options": {
        "baseURL": "http://localhost:8090/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "default": { "name": "Local Direct" }
      }
    },
    "tower": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.1.103:11234/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen3.8 27B",
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  },
  "plugin": ["opencode-plugin-openspec", "./.opencode/plugins/rtk.ts"],
  "mcp": {
    "idea": {
      "type": "remote",
      "url": "http://127.0.0.1:64564/sse",
      "headers": {},
      "enabled": true
    }
  },
  "agent": {
    // Primary agent — full tool access
    "build": {
      "description": "Main development agent with full tool access",
      "model": "litellm/agentic"
    },
    // Planning agent — read-only, asks before editing
    "plan": {
      "description": "Planning agent - analyzes and suggests without making changes",
      "model": "litellm/generalist",
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    // General-purpose subagent for multi-step tasks
    "general": {
      "description": "General-purpose agent for multi-step tasks",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/generalist",
      "prompt": "{file:./.opencode/prompts/general-instructions.md}",
      "permission": {
        "question": "allow",
        "skill": {
          "*": "deny",
          "frontend-impl": "allow",
          "commit-helper": "allow",
          "tdd": "allow"
        }
      }
    },
    // Read-only exploration subagent
    "explore": {
      "description": "Fast exploration agent - read-only code analysis",
      "mode": "subagent",
      "steps": 30,
      "model": "litellm/speed-cheapest",
      "prompt": "{file:./.opencode/prompts/explore-instructions.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": true
      },
      "permission": {
        "question": "allow",
        "skill": {
          "*": "deny",
          "zoom-out": "allow"
        }
      }
    },
    // Code quality review subagent
    "code-reviewer": {
      "description": "Code review agent - analyzes code quality and suggests improvements",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/agentic",
      "prompt": "{file:./.opencode/prompts/code-reviewer-instructions.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": false,
        "write": true
      },
      "permission": {
        "edit": "deny",
        "write": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "code-review": "allow",
          "review": "allow"
        }
      }
    },
    // Documentation writer subagent
    "docs-writer": {
      "description": "Documentation writer agent - generates and maintains docs",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/generalist",
      "prompt": "{file:./.opencode/prompts/docs-writer-instructions.md}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true
      },
      "permission": {
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "docs-writer": "allow"
        }
      }
    },
    // Security audit subagent
    "security-auditor": {
      "description": "Security audit agent - finds vulnerabilities and security issues",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/agentic",
      "prompt": "{file:./.opencode/prompts/security-auditor-instructions.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": false,
        "write": true
      },
      "permission": {
        "edit": "deny",
        "write": "allow",
        "question": "allow",
        "skill": {
          "*": "deny",
          "security-audit": "allow"
        }
      }
    },
    // System architect subagent
    "architect": {
      "description": "System architect - designs boundaries, interfaces, and codebase structure",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/design",
      "prompt": "{file:./.opencode/prompts/architect-instructions.md}",
      "permission": {
        "edit": "ask",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "researcher": "allow",
          "security-auditor": "allow"
        },
        "skill": {
          "*": "deny",
          "improve-codebase-architecture": "allow",
          "planner": "allow",
          "spec-writer": "allow"
        }
      }
    },
    // Root-cause debugger subagent
    "debugger": {
      "description": "Root cause analyst - isolates and fixes bugs",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/agentic",
      "prompt": "{file:./.opencode/prompts/debugger-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "diagnose": "allow",
          "tdd": "allow"
        }
      }
    },
    // QA test subagent
    "qa-engineer": {
      "description": "QA engineer - ensures quality via comprehensive test suites",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/agentic",
      "prompt": "{file:./.opencode/prompts/qa-engineer-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "tdd": "allow",
          "backend-impl": "allow"
        }
      }
    },
    // Database expert subagent
    "db-expert": {
      "description": "Database expert - manages schemas and query optimization",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/agentic",
      "prompt": "{file:./.opencode/prompts/db-expert-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "skill": {
          "*": "deny"
        }
      }
    },
    // DevOps CI/CD subagent
    "devops": {
      "description": "DevOps engineer - manages CI/CD and infrastructure",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/generalist",
      "prompt": "{file:./.opencode/prompts/devops-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "setup-pre-commit": "allow",
          "setup-matt-pocock-skills": "allow"
        }
      }
    },
    // Technical research subagent
    "researcher": {
      "description": "Technical researcher - analyzes docs and feasibility",
      "mode": "subagent",
      "steps": 30,
      "model": "litellm/speed-cheapest",
      "prompt": "{file:./.opencode/prompts/researcher-instructions.md}",
      "permission": {
        "edit": "deny",
        "write": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "question": "allow",
        "skill": {
          "*": "deny",
          "zoom-out": "allow"
        }
      }
    },
    // Implementation orchestrator — local tower model, delegates to impl-worker-cheap, audits results
    "impl-worker": {
      "description": "Implementation orchestrator - breaks work into chunks, delegates to cheap workers, audits results",
      "mode": "subagent",
      "steps": 100,
      "model": "tower/qwen3.8:27b",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/impl-worker-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "websearch": "deny",
        "webfetch": "deny",
        "question": "allow",
        "task": {
          "*": "deny",
          "impl-worker-cheap": "allow",
          "explore": "allow",
          "general": "allow"
        },
        "skill": {
          "*": "deny",
          "tdd": "allow",
          "task-breakdown": "allow",
          "backend-impl": "allow"
        }
      }
    },
    // Cheap implementation worker — executes single tasks under impl-worker supervision
    "impl-worker-cheap": {
      "description": "Cheap implementation worker - executes single atomic tasks under supervision",
      "mode": "subagent",
      "hidden": true,
      "steps": 50,
      "model": "litellm/agentic-free",
      "temperature": 0.3,
      "prompt": "{file:./.opencode/prompts/impl-worker-cheap-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "skill": {
          "*": "deny",
          "tdd": "allow",
          "backend-impl": "allow"
        }
      }
    },
    // Orchestrator agent — local-direct model, delegates, never implements
    "autopilot": {
      "description": "Orchestrator agent - delegates tasks to specialized subagents and ensures completion",
      "model": "local-direct/default",
      "color": "#00BFFF",
      "prompt": "{file:./.opencode/prompts/autopilot-instructions.md}"
    }
  },
  "default_agent": "plan",
  "subagent_depth": 2,
  // Common permissions — apply to ALL agents unless overridden per agent
  "permission": {
    "edit": "ask",
    "question": "allow",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git branch -D*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git checkout .*": "deny",
      "git checkout --*": "deny",
      "git restore .*": "deny",
      "git restore --*": "deny",
      "git stash drop*": "deny",
      "git gc*": "deny",
      "git commit*": "ask"
    }
  }
}
