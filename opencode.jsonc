{
  "$schema": "https://opencode.ai/config.json",
  // litellm provider config
  "model": "litellm/agentic",
  "small_model": "litellm/speed",
  "shell": "powershell",
  "instructions": [
    ".opencode/docs/git-safety.md",
    ".opencode/prompts/subagent-routing.md",
    ".opencode/standards/README.md"
  ],
  "provider": {
    "litellm": {
      "options": {
        "baseURL": "http://192.168.1.103:4000/v1",
        "apiKey": "sk-litellm-master-key"
      },
      "models": {
        "reasoning":      { "name": "Reasoning" },
        "design":         { "name": "Design" },
        "agentic": {
          "name": "Agentic",
          "variants": {
            "low": { "reasoningEffort": "low" }
          }
        },
        "agentic-free":   { "name": "Agentic Free" },
        "generalist":     { "name": "Generalist" },
        "speed":          { "name": "Speed" },
        "speed-cheapest": { "name": "Speed Cheapest" },
        "local": {
          "name": "Local",
          "variants": {
            "none":   { "reasoningEffort": "none" },
            "low":    { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high":   { "reasoningEffort": "high" }
          }
        }
      }
    },
    "local-direct": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8090/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "default": {
          "name": "Local Direct",
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    },
    "tower": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.1.103:11234/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen3.8 27B",
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  },
  "plugin": ["opencode-plugin-openspec", "./.opencode/plugins/rtk.ts", "./.opencode/plugins/scratch.ts", "./.opencode/plugins/session-affinity.ts"],
  "mcp": {
    "idea": {
      "type": "remote",
      "url": "http://127.0.0.1:64564/sse",
      "headers": {},
      "enabled": true
    },
    // Web/mobile UI tooling — scoped to ui-impl-worker + ui-reviewer only.
    // The server processes still spawn at startup (MCP has no per-agent enable),
    // but the *tools* are hidden globally via the `tools` glob and re-enabled
    // per agent, so only those two agents can invoke them. See "tools" block.
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--headless", "--no-usage-statistics", "--no-performance-crux"],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--caps", "vision,devtools"],
      "enabled": true,
      "timeout": 30000
    }
  },
  // Globally hide the UI browser MCP tools from every agent. They are
  // re-enabled ONLY for ui-impl-worker and ui-reviewer in their "tools" blocks.
  // MCP tool names are prefixed with the server name (e.g. chrome-devtools_navigate_page).
  "tools": {
    "chrome-devtools*": false,
    "playwright*": false
  },
  "agent": {
    // Primary agent — full tool access
    "build": {
      "description": "Main development agent with full tool access",
      "model": "litellm/agentic"
    },
    // Planning agent — read-only, asks before editing
    "plan": {
      "description": "Planning agent - analyzes and suggests without making changes",
      "model": "litellm/generalist",
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    // General-purpose subagent for multi-step tasks
    "general": {
      "description": "General-purpose agent for multi-step tasks",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/generalist",
      "prompt": "{file:./.opencode/prompts/general-instructions.md}",
      "permission": {
        "question": "allow",
        "skill": {
          "*": "deny",
          "frontend-impl": "allow",
          "commit-helper": "allow",
          "tdd": "allow"
        }
      }
    },
    // Read-only exploration subagent
    "explore": {
      "description": "Fast exploration agent - read-only code analysis",
      "mode": "subagent",
      "steps": 30,
      "model": "litellm/speed-cheapest",
      "prompt": "{file:./.opencode/prompts/explore-instructions.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": true
      },
      "permission": {
        "question": "allow",
        "skill": {
          "*": "deny",
          "zoom-out": "allow"
        }
      }
    },
    // Code quality review subagent
    "code-reviewer": {
      "description": "Code review agent - analyzes code quality and suggests improvements",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/agentic",
      "prompt": "{file:./.opencode/prompts/code-reviewer-instructions.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": false,
        "write": true
      },
      "permission": {
        "edit": "deny",
        "write": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "code-review": "allow",
          "review": "allow"
        }
      }
    },
    // UI implementation worker — web (React) + mobile (Expo/React Native).
    // Owns browser MCP tools (chrome-devtools + playwright) for live UI work.
    // Spawns ui-reviewer to audit its own output before reporting done.
    "ui-impl-worker": {
      "description": "Web/mobile UI implementation worker - React web + Expo/React Native, drives real browsers to build and verify UI",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/local",
      "variant": "low",
      "temperature": 0.2,
      "prompt": "{file:./.opencode/prompts/ui-impl-worker-instructions.md}",
      // Browser MCPs re-enabled here (hidden globally via top-level "tools").
      "tools": {
        "chrome-devtools*": true,
        "playwright*": true
      },
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "deny",
          "ui-reviewer": "allow",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "frontend-impl": "allow",
          "mobile-impl": "allow",
          "tdd": "allow",
          "task-breakdown": "allow",
          "code-review": "allow"
        }
      }
    },
    // UI/UX reviewer — audits UI/UX quality. Read-only on code, but has browser
    // MCPs to take screenshots and inspect the live app. Spawned by ui-impl-worker.
    "ui-reviewer": {
      "description": "UI/UX reviewer - audits visual design, accessibility, and responsive behavior of web/mobile UI",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/agentic",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/ui-reviewer-instructions.md}",
      "tools": {
        "chrome-devtools*": true,
        "playwright*": true
      },
      "permission": {
        "edit": "deny",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "code-review": "allow"
        }
      }
    },
    // Documentation writer subagent
    "docs-writer": {
      "description": "Documentation writer agent - generates and maintains docs",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/generalist",
      "prompt": "{file:./.opencode/prompts/docs-writer-instructions.md}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true
      },
      "permission": {
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "docs-writer": "allow"
        }
      }
    },
    // System architect subagent
    "architect": {
      "description": "System architect - designs boundaries, interfaces, and codebase structure",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/design",
      "prompt": "{file:./.opencode/prompts/architect-instructions.md}",
      "permission": {
        "edit": "ask",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "websearcher": "allow"
        },
        "skill": {
          "*": "deny",
          "improve-codebase-architecture": "allow",
          "planner": "allow",
          "spec-writer": "allow",
          "openspec-new-change": "allow",
          "openspec-propose": "allow",
          "openspec-ff-change": "allow",
          "openspec-continue-change": "allow"
        }
      }
    },
    // Root-cause debugger subagent
    "debugger": {
      "description": "Root cause analyst - isolates and fixes bugs",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/agentic",
      "prompt": "{file:./.opencode/prompts/debugger-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "diagnose": "allow",
          "tdd": "allow"
        }
      }
    },
    // Web researcher — external research via web search/fetch, hardened against prompt injection
    "websearcher": {
      "description": "Web researcher - external research via web search/fetch, hardened against prompt injection",
      "mode": "subagent",
      "steps": 30,
      "model": "litellm/speed-cheapest",
      "prompt": "{file:./.opencode/prompts/websearcher-instructions.md}",
      "permission": {
        "edit": "deny",
        "write": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "question": "allow",
        "skill": {
          "*": "deny"
        }
      }
    },
    // Implementation orchestrator — local model (low reasoning), delegates to impl-worker-cheap, audits results
    "impl-worker": {
      "description": "Implementation orchestrator - breaks work into chunks, delegates to cheap workers, audits results",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/local",
      "variant": "low",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/impl-worker-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "websearch": "deny",
        "webfetch": "deny",
        "question": "allow",
        "task": {
          "*": "deny",
          "impl-worker-cheap": "allow",
          "explore": "allow",
          "general": "allow"
        },
        "skill": {
          "*": "deny",
          "tdd": "allow",
          "task-breakdown": "allow",
          "backend-impl": "allow",
          "openspec-apply-change": "allow"
        }
      }
    },
    // Cheap implementation worker — local model (no reasoning), executes single tasks under impl-worker supervision
    "impl-worker-cheap": {
      "description": "Cheap implementation worker - executes single atomic tasks under supervision",
      "mode": "subagent",
      "hidden": true,
      "steps": 50,
      "model": "litellm/local",
      "variant": "none",
      "temperature": 0.3,
      "prompt": "{file:./.opencode/prompts/impl-worker-cheap-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "skill": {
          "*": "deny",
          "tdd": "allow",
          "backend-impl": "allow"
        }
      }
    },
    // Detail designer — turns specs into design.md + atomic task list with file ownership
    "designer": {
      "description": "Detail designer - turns specs into design decisions and an atomic task list",
      "mode": "subagent",
      "steps": 50,
      "model": "litellm/design",
      "temperature": 0.2,
      "prompt": "{file:./.opencode/prompts/designer-instructions.md}",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "spec-writer": "allow",
          "planner": "allow",
          "openspec-new-change": "allow",
          "openspec-continue-change": "allow",
          "openspec-ff-change": "allow"
        }
      }
    },
    // Verification gate — runs tests, reviews against spec, writes verdict. Never edits code.
    "verifier": {
      "description": "Verification gate - runs tests, reviews code against spec, writes verdict report",
      "mode": "subagent",
      "steps": 100,
      "model": "litellm/agentic",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/verifier-instructions.md}",
      "permission": {
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "code-review": "allow",
          "review": "allow",
          "openspec-verify-change": "allow"
        }
      }
    },
    // Independent review gate — reviews spec, subspec, and code against loaded standards.
    // Loads different standards files based on the target (spec/subspec/code).
    // Runs in a fresh context (LPM-004). Never edits — reports findings only.
    "reviewer": {
      "description": "Independent review gate - reviews spec/subspec/code against standards, reports findings by severity",
      "mode": "subagent",
      "steps": 60,
      "model": "litellm/agentic",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/reviewer-instructions.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": false,
        "write": true,
        "bash": true
      },
      "permission": {
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow",
        "bash": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "skill": {
          "*": "deny",
          "code-review": "allow"
        }
      }
    },
    // Orchestrator agent — local model (medium reasoning), drives the lifecycle state machine, never implements
    "autopilot": {
      "description": "Orchestrator agent - drives the OpenSpec lifecycle state machine, delegates every phase, never implements",
      "model": "litellm/local",
      "variant": "medium",
      "color": "#00BFFF",
      "prompt": "{file:./.opencode/prompts/autopilot-instructions.md}",
      "permission": {
        "edit": {
          "*": "allow",
          ".autopilot/**/state.json": "deny"
        },
        "write": {
          "*": "allow",
          ".autopilot/**/state.json": "deny"
        },
        "task": {
          "*": "deny",
          "architect": "allow",
          "designer": "allow",
          "reviewer": "allow",
          "impl-worker": "allow",
          "ui-impl-worker": "allow",
          "verifier": "allow",
          "explore": "allow",
          "websearcher": "allow",
          "general": "allow"
        }
      }
    }
  },
  "default_agent": "plan",
  "subagent_depth": 3,
  // Common permissions — apply to ALL agents unless overridden per agent
   "permission": {
     "edit": {
       "*": "allow",
       // State run-records are owned by the autopilot_state tool — never hand-edited.
       ".autopilot/**/state.json": "deny"
     },
     "question": "allow",
     "external_directory": "allow",
     // .tmp scratch space — writable by every agent/subagent, even those that
     // narrow their own edit/write permission. Covers write + edit + patch to .tmp/**.
     "write": {
       ".tmp/**": "allow",
       ".autopilot/**/state.json": "deny"
     },
     "bash": {
       "*": "allow",
       "git push*": "ask",
       "rtk git push*": "ask",
       "git push --force*": "deny",
       "git push -f*": "deny",
       "rtk git push --force*": "deny",
       "rtk git push -f*": "deny",
       "git reset --hard*": "deny",
       "rtk git reset --hard*": "deny",
       "git clean *": "deny",
       "rtk git clean *": "deny",
       "git clean -n*": "allow",
       "rtk git clean -n*": "allow",
       "git checkout .": "deny",
       "git checkout --*": "deny",
       "git checkout -f*": "deny",
       "git restore .": "deny",
       "git restore --*": "deny",
       "rtk git checkout .": "deny",
       "rtk git checkout --*": "deny",
       "rtk git checkout -f*": "deny",
       "rtk git restore .": "deny",
       "rtk git restore --*": "deny",
       "git branch -D*": "deny",
       "rtk git branch -D*": "deny",
       "git stash drop*": "deny",
       "git stash clear*": "deny",
       "rtk git stash drop*": "deny",
       "rtk git stash clear*": "deny"
     }
   }
}
